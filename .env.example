APP_NAME="SIDIK Calibration"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidik_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime sync mobile <-> desktop. `log` aman buat dev (nge-log doang).
# Di produksi: `reverb` + jalanin `php artisan reverb:start`.
# Lihat docs/realtime-sync.md (arsitektur + contoh klien Echo) dan
# docs/infrastruktur-vps-produksi.md (bagian "Yang jalan di VPS").
#
# PENTING: `reverb` belum bisa dipakai sebelum `composer require laravel/reverb`
# (paketnya, termasuk pusher/pusher-php-server, memang belum terpasang di repo
# ini). Sebelum itu terpasang, nyetel `reverb` di sini bikin /api/broadcasting/auth
# gagal dengan "Class Pusher\Pusher not found" — bukan salah kodenya.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (websocket self-host). Isi & set BROADCAST_CONNECTION=reverb
# sesudah `composer require laravel/reverb`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Anthropic Claude — AI Vision buat baca lembar kerja dari foto (ganti OCR).
# ANTHROPIC_MODEL bisa diganti ke claude-sonnet-5 kalau butuh lebih cepat/murah.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT=60
# ANTHROPIC_STRUCTURED_OUTPUT=true

VITE_APP_NAME="${APP_NAME}"
