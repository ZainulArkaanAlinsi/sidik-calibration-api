APP_NAME="SIDIK Calibration"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Sandi awal buat akun yang dibentuk seeder — CUMA kepakai di server.
#
# Di laptop (APP_ENV=local) seeder selalu pakai `rahasia123` dan baris ini
# diabaikan, jadi biarin kosong di sini. Di server `rahasia123` nggak boleh
# kepakai: repo ini publik, jadi sandi itu tercetak di docs/kontrak-api.md dan
# di seeder-nya sendiri, sementara nama service di render.yaml bikin alamat
# servernya gampang ditebak.
#
# Dikosongin di server juga aman — seeder bikin sandi acak 32 karakter dan
# nyetak sekali ke log deploy buat disalin.
#
# Apa pun isinya, sandi ini CUMA dipasang ke akun yang baru kebentuk. Seeder
# nggak pernah nyetel ulang sandi akun yang sudah ada, jadi ngisi baris ini
# nggak bakal nimpa sandi yang sudah diganti admin lewat panel.
SEED_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidik_db
DB_USERNAME=root
DB_PASSWORD=

# Database PRODUKSI, dipakai dari laptop lewat `--koneksi=produksi`.
#
# Buat apa: Render paket gratis tidak punya Shell, jadi perintah sekali-seumur-
# hidup seperti `php artisan customers:impor` tidak bisa dijalankan di server.
# Dijalankan dari laptop, menembak database yang dipakai server.
#
# SENGAJA DIKOMENTARI, bukan dibiarkan kosong. Hapus `#` dan isi hanya di
# laptop yang sedang mengimpor.
#
# Bedanya bukan gaya penulisan. Kunci yang ADA TAPI KOSONG di `.env` MENANG atas
# nilai bawaan di `env()` — bawaan cuma berlaku kalau kuncinya tidak ada sama
# sekali. Jadi kalau baris-baris ini ditulis sebagai `DB_PRODUKSI_HOST=`, dan
# suatu saat ada yang "merapikan" config/database.php jadi
# `env('DB_PRODUKSI_HOST', '127.0.0.1')` seperti koneksi `mysql`, bawaan
# berbahaya itu tidak akan pernah terpicu di CI — dan penjaga di
# ImporPelangganTest ikut mandul tanpa satu pun test berubah warna.
#
# Dikomentari, kuncinya benar-benar tidak ada, bawaannya terpicu, dan test itu
# menangkapnya. Sudah dibuktikan merah-duluan dua kali.
#
# Nilainya diambil dari dashboard Render (service -> Environment). JANGAN
# di-commit: berkas ini masuk git, `.env` tidak.
#
# Kunci ini TIDAK ada di `render.yaml`, dan itu disengaja — server tidak butuh
# jalur "ke produksi" dari dalam produksi.
#
# DB_PRODUKSI_SSL_CA menunjuk berkas .pem yang diunduh dari penyedia database;
# tanpa itu Aiven menolak sambungannya.
#
# DB_PRODUKSI_HOST=
# DB_PRODUKSI_PORT=
# DB_PRODUKSI_DATABASE=
# DB_PRODUKSI_USERNAME=
# DB_PRODUKSI_PASSWORD=
# DB_PRODUKSI_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime sync mobile <-> desktop. `log` aman buat dev (nge-log doang).
# Di produksi: `reverb` + jalanin `php artisan reverb:start`.
# Lihat docs/realtime-sync.md (arsitektur + contoh klien Echo) dan
# docs/infrastruktur-vps-produksi.md (bagian "Yang jalan di VPS").
#
# `laravel/reverb` SUDAH terpasang. Bawaan di sini tetap `log` supaya clone
# baru & test nggak butuh websocket server nyala; ganti ke `reverb` di `.env`
# masing-masing begitu servernya dijalanin.
#
# Buat nyalain di mesin sendiri:
#   php artisan reverb:install     # ngisi REVERB_APP_ID/KEY/SECRET di .env
#   php artisan reverb:start       # servernya, biarkan jalan
#   BROADCAST_CONNECTION=reverb    # di .env, bukan di sini
#
# Selama masih `log`, notifikasi tetap kesimpen di database dan tetap kelihatan
# di lonceng — yang nggak jalan cuma yang REALTIME: lonceng nggak nyala
# barengan HP↔desktop, dan notifikasi sistem operasi nggak nongol karena
# app-nya nggak pernah dikabarin.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (websocket self-host). Diisi `php artisan reverb:install`.
#
# REVERB_APP_KEY ikut dipakai aplikasi mobile lewat --dart-define=REVERB_APP_KEY;
# itu memang kunci PUBLIK (klien wajib tahu). REVERB_APP_SECRET TIDAK boleh
# ikut ke mobile — dia yang dipakai server buat nandatangani otorisasi channel
# privat, dan repo mobile-nya publik.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Kirim sertifikat ke pelanggan.
#
# `log` = email cuma DICATAT ke storage/logs/laravel.log, NGGAK dikirim ke
# siapa pun. Bagus buat ngoprek, tapi di server beneran ini artinya sertifikat
# nggak pernah nyampe pelanggan — dan `Mail::send()` tetap "berhasil", nggak ada
# error yang keliatan. API-nya sekarang ngasih peringatan tegas kalau nemu ini
# (lihat `CertificateController::mailerTakMengirim()`), tapi peringatan tetap
# bukan pengganti setelan yang bener.
#
# Buat produksi: ganti `log` jadi `smtp` dan isi empat baris di bawahnya.
# Gmail/Workspace butuh App Password, bukan password akun biasa.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Alamat ini yang kebaca pelanggan sebagai pengirim — pakai domain lab, jangan
# dibiarin `example.com` (banyak server nolak / naruh ke spam).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Saklar pemindahan berkas awet ke object storage: `local` atau `s3`.
#
# Yang ikut: PDF sertifikat, gambar tanda tangan, dokumen Folder Manager, dan
# foto titik ukur — semuanya lewat disk bernama `arsip` (config/filesystems.php).
#
# Di laptop biarin `local`. Ini saklarnya, BUKAN FILESYSTEM_DISK: variabel yang
# terakhir itu cuma dibaca baris `'default'`, dan nggak ada satu pun pemakaian
# `Storage::` di app/ yang memakai disk default.
ARSIP_DRIVER=local

# Prefix kunci di bucket. Biarin kosong biar kuncinya sama persis dengan nilai
# yang sudah tersimpan di database ('certificates/...', 'tanda-tangan/...').
ARSIP_PREFIX=

# Penyimpanan berkas di luar server — dipakai kalau ARSIP_DRIVER=s3.
#
# Yang dituju Cloudflare R2 (gratis 10 GB), BUKAN Amazon. Namanya tetap AWS_*
# karena R2 bicara protokol S3 yang sama; nggak perlu akun AWS.
#
# Kenapa perlu di server: disk container Render kehapus tiap deploy dan tiap
# container bangun ulang, jadi foto lembar kerja, tanda tangan, logo, dan PDF
# sertifikat ikut hilang tiap kali kode di-push. Di laptop biarin `local` —
# disknya nggak ke mana-mana.
#
# AWS_ENDPOINT bentuknya https://<account-id>.r2.cloudflarestorage.com,
# TANPA nama bucket di belakangnya. AWS_DEFAULT_REGION wajib "auto": R2 nggak
# punya konsep region, tapi SDK-nya tetap minta kolom itu terisi.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Cuma perlu kalau bucket-nya publik dan berkas diakses lewat URL langsung.
AWS_URL=

# --- Vision AI (kamera lembar kerja) ---
# Penyedia yang dipakai: `gemini` (default kode & yang kepakai produksi) atau
# `anthropic`. Isi key penyedia yang kamu pilih aja — yang satunya boleh
# dibiarkan kosong.
#
# Berkas ini sempat nulis `anthropic` sementara kodenya default `gemini` dan
# produksi pakai `gemini`. Server baru yang nyalin berkas ini bakal nembak
# penyedia yang keynya nggak diisi, dan gagalnya baru ketahuan waktu teknisi
# udah di lapangan megang alat — bukan waktu deploy.
VISION_DRIVER=gemini
# Saklar jalur pindai AI (POST /raw-measurements/extract-from-photo).
# false = endpointnya balik 503 tanpa pernah nyentuh layanan pihak ketiga.
# Jalur pindai utama sekarang lokal (POST /worksheet-scans, OCR di HP); yang ini
# cadangan, dan dia mengirim foto lembar kerja pelanggan keluar server.
VISION_AKTIF=true

# KALAU KAMERANYA TIBA-TIBA MATI, cek ini dulu sebelum nyalahin foto/kode:
#   1. Saldo Gemini habis? Gejalanya 429 "credits are depleted" —
#      NGGAK sembuh dengan nunggu, mesti diisi di https://ai.studio/projects.
#      Log: storage/logs/laravel.log → "WorksheetVisionExtractor: Gemini balik error".
#   2. Nama modelnya masih hidup? Lihat perintah curl di bawah.

# Google Gemini — dipakai kalau VISION_DRIVER=gemini.
# Key dari https://aistudio.google.com/apikey — dua format prefix yang beredar
# (lama & baru) dua-duanya jalan, nggak usah dikonversi.
# GEMINI_MODEL WAJIB dicek masih hidup sebelum deploy: nama model Gemini mati
# tanpa aba-aba, dan errornya nyamar jadi masalah key —
#   404 "no longer available to new users"  → nama modelnya yang mati
#   429 "exceeded your current quota"       → model lama kena batas free tier
# Daftar yang masih kejawab key kamu:
#   curl https://generativelanguage.googleapis.com/v1beta/models \
#     -H "x-goog-api-key: $GEMINI_API_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MAX_TOKENS=4096
# GEMINI_TIMEOUT=60

# Anthropic Claude — AI Vision buat baca lembar kerja dari foto (ganti OCR).
# ANTHROPIC_MODEL bisa diganti ke claude-sonnet-5 kalau butuh lebih cepat/murah.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT=60
# ANTHROPIC_STRUCTURED_OUTPUT=true

# --- Kolom R² blok %T (Spectrophotometer) ---
# JANGAN dinyalain sebelum ada jawaban tertulis dari lab. Angka R² di master
# (0,9359) beda dari yang tercetak di sertifikat yang beredar (1), dan dua-duanya
# nggak bisa dilahirkan dari data blok itu. Duduk perkaranya lengkap di
# docs/pertanyaan-lab-r2-spektro.md.
#   off              kolom R² nggak dicetak sama sekali (bawaan)
#   rsq_standar_uut  R² = RSQ(Standard %T, UUT %T) atas seluruh titik blok %T
# SPEKTRO_R2=off

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging — push buat HP yang aplikasinya KETUTUP TOTAL.
# Kosongin = push mati; notifikasi tetap masuk database, tetap muncul di
# lonceng, dan tetap disiarkan Reverb ke aplikasi yang lagi jalan.
#
# FCM_CREDENTIALS nunjuk berkas service account JSON dari Firebase Console
# (Project Settings > Service accounts > Generate new private key). Simpan DI
# LUAR repo — itu kunci SERVER. Beda dari REVERB_APP_KEY yang memang publik dan
# ikut ke aplikasi mobile.
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# Direktori perusahaan — cari nama & alamat PT dari sumber LUAR, dipakai waktu
# teknisi mendaftarkan pelanggan yang belum ada di master lab.
#
# Pencarian di master lab & ketik tangan SELALU jalan penuh, apa pun isi bagian
# ini. Yang disetel di sini cuma lapis tambahannya.
#
# `osm` (bawaan) = OpenStreetMap lewat Nominatim saja. Tanpa key, tanpa kuota,
# TANPA TAGIHAN. Bayarannya cakupan yang lebih tipis: cuma tempat yang pernah
# dipetakan sukarelawan, jadi pabrik di kawasan industri yang belum ada yang
# memetakan memang nggak akan ketemu.
#
# `google` = Places API saja. Cakupan pabrik Indonesia paling tebal. Tanpa key,
# jalur ini mati total.
#
# `auto` = BERLAPIS. Google duluan kalau key-nya terisi, lalu OpenStreetMap.
# Dua sumber ini kelemahannya berlawanan — Google cakupannya tebal tapi bisa
# mati karena setelan/kuota; OSM nyaris nggak pernah mati tapi cakupannya
# tipis. Berurutan, yang tersisa cuma irisannya.
#
# Nilai yang NGGAK DIKENALI jatuh ke `osm`, bukan bikin aplikasi melempar:
# salah ketik di berkas ini nggak boleh mematikan pendaftaran pelanggan di
# lapangan — dan nggak boleh diam-diam menyalakan lagi jalur yang ditagih.
#
# Key Google itu kunci SERVER — jangan pernah ditaruh di aplikasi HP: key di
# dalam APK bisa dicabut siapa pun dari berkasnya lalu dipakai atas tagihan lab
# ini. Text Search punya kuota bebas bulanan (5.000 panggilan/bulan sejak Mar
# 2025); di atas itu ditagih per request, jadi kalau DRIVER dipindah ke
# `google`/`auto`, pasang juga batas kuotanya di konsol Google — jangan cuma
# andalkan throttle di server.
DIREKTORI_PERUSAHAAN_DRIVER=osm

# Cuma dipakai kalau DRIVER=google (wajib) atau DRIVER=auto (lapis pertama).
# Di bawaan `osm` baris ini nggak pernah dibaca. Kosong bukan kerusakan: OSM
# jalan tanpa key, cuma cakupannya lebih tipis.
DIREKTORI_PERUSAHAAN_KEY=

# Nominatim MENOLAK klien yang nggak menyebut dirinya, dan yang diblokir alamat
# IP server-nya — bukan satu request. Isi dengan nama aplikasi + cara
# menghubungi yang beneran bisa dihubungi.
#
# Dikosongkan pun aman: NominatimDirektori punya nilai bawaannya sendiri, jadi
# yang berangkat nggak pernah anonim. Barisnya SENGAJA diisi di sini — berkas
# ini disalin apa adanya jadi `.env` di CI, dan `KEY=` yang kosong mulangin
# string kosong (bukan `null`), yang lolos dari nilai bawaan di config.
DIREKTORI_PERUSAHAAN_USER_AGENT="SidikCalibration/1.0 (+https://github.com/ZainulArkaanAlinsi/sidik-calibration-api)"

DIREKTORI_PERUSAHAAN_TIMEOUT=8

# ---------------------------------------------------------------------------
# Yang dilaporkan GET /api/health -> blok `deploy` (lihat config/deploy.php)
# ---------------------------------------------------------------------------

# Seeder jalan tiap container nyala. Di laptop biarin kosong/false.
#
# Di server: NYALAIN SEKALI pas deploy pertama, terus MATIIN. Kalau dibiarkan
# `true`, DemoDataSeeder menulis ulang seluruh sesi contoh tiap boot — menit
# yang diambil dari jendela health check Render yang cuma 15 menit, dan itu
# tersangka utama deploy yang timeout. Saklarnya sendiri dibaca
# docker/entrypoint.sh langsung dari shell.
SEED_ON_BOOT=false

# RENDER_GIT_COMMIT SENGAJA nggak ditulis di sini, dan nggak boleh ditaruh di
# render.yaml: Render menyuntiknya sendiri ke tiap container. Ditulis manual,
# yang dilaporkan /api/health jadi commit yang salah — persis kebohongan yang
# field itu dibikin buat mencegah. Di laptop dia kosong, dan `null` di health
# memang jawaban yang benar di situ.
