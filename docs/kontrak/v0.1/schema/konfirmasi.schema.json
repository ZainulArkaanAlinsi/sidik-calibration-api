{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.sidik.invalid/kontrak/v0.1/konfirmasi.schema.json",
  "title": "Konfirmasi (kontrak antar-terminal v0.1)",
  "description": "Catatan TERSIMPAN dari satu tindakan manusia yang mengubah usulan OCR menjadi data pengukuran draf. Dibuat server (bukan klien). Hanya bertambah (append-only): koreksi = catatan baru dengan urutan lebih besar, catatan lama tidak ditimpa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kontrak_versi", "pindai_id", "urutan", "dikonfirmasi_oleh", "waktu", "item"],
  "properties": {
    "kontrak_versi": { "const": "0.1" },
    "pindai_id": { "$ref": "#/$defs/pindai_id" },
    "urutan": {
      "description": "1 untuk konfirmasi pertama pindaian ini, naik satu tiap konfirmasi berikutnya (koreksi).",
      "type": "integer",
      "minimum": 1
    },
    "dikonfirmasi_oleh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "peran"],
      "properties": {
        "user_id": { "type": "integer", "minimum": 1 },
        "peran": {
          "description": "Peran akun saat bertindak. super_admin tercatat sebagai super_admin, tidak pernah menyamar.",
          "enum": ["teknisi", "admin", "super_admin"]
        }
      }
    },
    "waktu": { "$ref": "#/$defs/waktu" },
    "item": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "nilai_usulan", "nilai_sebelum", "nilai_final", "diubah", "alasan_jika_diubah", "master_id"],
        "properties": {
          "item_id": { "$ref": "#/$defs/id_item" },
          "nilai_usulan": {
            "description": "Nilai usulan mesin untuk kotak ini (salinan, tidak berubah antar konfirmasi).",
            "type": ["string", "null"],
            "maxLength": 200
          },
          "nilai_sebelum": {
            "description": "Nilai yang dilihat manusia saat bertindak: nilai_usulan pada urutan 1, nilai_final catatan sebelumnya pada urutan berikutnya.",
            "type": ["string", "null"],
            "maxLength": 200
          },
          "nilai_final": { "type": ["string", "null"], "maxLength": 200 },
          "diubah": {
            "description": "true bila nilai_final berbeda dari nilai_sebelum. Server yang menghitung; klien tidak mengirimnya.",
            "type": "boolean"
          },
          "alasan_jika_diubah": { "type": ["string", "null"], "maxLength": 1000 },
          "master_id": { "type": ["integer", "null"], "minimum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "diubah": { "const": true } }, "required": ["diubah"] },
            "then": {
              "properties": {
                "alasan_jika_diubah": { "type": "string", "pattern": "\\S" }
              }
            }
          },
          {
            "if": { "properties": { "diubah": { "const": false } }, "required": ["diubah"] },
            "then": { "properties": { "alasan_jika_diubah": { "type": "null" } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "id_item": {
      "description": "Opak dan stabil antar revisi (KONTRAK.md bagian 4). Klien tidak boleh menafsirkan isinya.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "pindai_id": {
      "description": "Diterbitkan server (satu per unggahan foto yang diterima).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "waktu": {
      "description": "ISO 8601 lengkap dengan zona (Z atau +07:00).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
