{
    // `@import 'tailwindcss'`, `@source`, dan `@theme` itu at-rule bawaan
    // Tailwind v4. Validator CSS bawaan VS Code belum kenal, jadi dia
    // nandain sebagai "Unknown at rule" — padahal file-nya bener dan
    // `npm run build` jalan normal.
    //
    // Dimatiin di level project (bukan per-orang) supaya semua yang buka repo
    // ini lihat editor yang sama bersihnya, nggak cuma yang kebetulan udah
    // ngatur sendiri.
    "css.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",

    // File Blade nyampur PHP ke dalam CSS, dan itu emang nggak bisa dihindari:
    // `style="width: {{ $lebar }}mm"` di sertifikat/pdf.blade.php, plus `@if`
    // di dalam blok style buat mode web. Validator CSS bawaan VS Code baca itu
    // sebagai CSS rusak — padahal yang sampai ke browser hasil render Blade,
    // bukan sumbernya.
    //
    // Cuma validasi style yang NEMPEL di HTML yang dimatiin. File .css berdiri
    // sendiri (resources/css/app.css) tetap divalidasi seperti biasa.
    "html.validate.styles": false,

    // Setelan di atas ternyata belum cukup: dia cuma ngatur layanan HTML bawaan
    // VS Code, yang jalan di file berbahasa `html`. File `.blade.php` kebaca
    // sebagai `php`, dan yang mvalidasi CSS di dalamnya justru Intelephense —
    // dia bawa layanan CSS sendiri buat bagian HTML/CSS/JS yang nempel di file
    // PHP.
    //
    // Contoh yang dilaporin merah padahal bener: emails/sertifikat.blade.php
    // baris 104, `padding-left:{{ $logo ? '14px' : '0' }};` — parser CSS berenti
    // di `{{` terus ngelapor "identifier expected" plus "} expected" beruntun.
    // Ada 24 test di KirimEmailSertifikatTest yang ngerender email itu sampai
    // jadi, dan `php artisan view:cache` juga lolos; jadi yang salah pembacanya,
    // bukan templatnya.
    //
    // Jangan diganti jadi `"files.associations": {"*.blade.php": "blade"}`.
    // Nggak ada ekstensi terpasang yang ndaftarin bahasa `blade` (dicek 13 Agt
    // 2026), jadi file-nya jatuh ke plaintext: penanda merahnya ilang karena
    // editor jadi buta — warna sintaks, lompat ke definisi, dan autocomplete
    // ikut mati di semua file Blade.
    "intelephense.diagnostics.embeddedLanguages": false,

    // PHP Tools (DEVSENSE) nebak tipe properti model dari `casts()`, dan buat
    // cast `date` dia bikin tipe khayalan bernama `date` — bukan Carbon. Jadi
    // `$sertifikat->diterbitkan_pada?->toDateString()` dilaporin "Call to
    // unknown method: date::toDateString()" (PHP0418) padahal jalan normal.
    // Anotasi `@mixin IdeHelperCertificate` sama `_ide_helper_models.php` udah
    // nulis `\Illuminate\Support\Carbon|null`, tapi tebakan cast-nya menang.
    //
    // Cuma kode 418 yang dibungkam, dan cuma dari PHP Tools. Intelephense masih
    // ngelapor method yang beneran nggak ada lewat
    // `intelephense.diagnostics.undefinedMethods`, jadi salah ketik nama method
    // tetap ketahuan.
    "php.problems.exclude": {
        "/": [418]
    },

    // `_ide_helper.php` ukurannya ~1,1 MB — lewat tipis dari batas bawaan
    // Intelephense (1 MB), jadi file itu DILEWATI waktu indexing. Akibatnya
    // percuma: `Storage::disk()->download()`, `->url()`, `assertExists()` tetap
    // dilaporin "Undefined method" walaupun helper-nya udah digenerate.
    //
    // Gejalanya nyesatin — file-nya ada, isinya bener, tapi nggak kebaca. Yang
    // ngasih tau cuma log Intelephense ("is over the maximum file size"), dan
    // nggak ada yang buka log itu.
    "intelephense.files.maxSize": 5000000,

    // ---------------------------------------------------------------------
    // Beban indexing. Ditulis sesudah VS Code kedapatan berat di repo ini.
    // ---------------------------------------------------------------------
    //
    // Yang bikin berat BUKAN berkas sampah yang bisa dihapus — tiga penyumbang
    // terbesarnya justru wajib ada: `vendor/` (194 MB) dipakai buat jalan DAN
    // dibaca Intelephense buat autocomplete Laravel, `node_modules/` (43 MB)
    // dipakai `npm run build`, dan `storage/app/private/certificates/` (54 MB,
    // 41 PDF) itu sertifikat terbit — dokumen resmi, bukan cache.
    //
    // Jadi yang dikurangi beban BACA-nya, bukan berkasnya. Dua setelan di
    // bawah sengaja dipisah karena efeknya beda:
    //
    //  - `files.watcherExclude` — berhenti masang file watcher OS. Ini yang
    //    paling kerasa: tiap berkas di bawah direktori ini butuh satu handle,
    //    dan `vendor/` sendirian isinya puluhan ribu berkas. Nol kerugian —
    //    watcher cuma buat mendeteksi perubahan dari luar editor, dan nggak
    //    ada yang menyunting vendor dengan tangan.
    //
    //  - `search.exclude` — buang dari Ctrl+Shift+F. Ini ADA kerugiannya:
    //    sesekali kita emang perlu ngintip sumber Laravel. Makanya vendor
    //    TIDAK dibuang dari sini; yang dibuang cuma keluaran yang digenerate
    //    (build Vite, storage, helper IDE) yang hasil carinya selalu palsu —
    //    `_ide_helper_models.php` bikin tiap nama kolom kena dua kali.
    //
    // Yang TIDAK boleh ditambahin ke sini: `vendor/` di `files.exclude` atau
    // di setelan Intelephense. Itu bikin autocomplete & "go to definition"
    // seluruh Laravel mati — hemat memori, tapi editornya jadi buta.
    "files.watcherExclude": {
        "**/vendor/**": true,
        "**/node_modules/**": true,
        "**/storage/app/**": true,
        "**/storage/framework/**": true,
        "**/storage/logs/**": true,
        "**/public/build/**": true,
        "**/.git/objects/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/public/build": true,
        "**/storage/app": true,
        "**/storage/framework": true,
        "**/storage/logs": true,
        "_ide_helper.php": true,
        "_ide_helper_models.php": true
    }
}
