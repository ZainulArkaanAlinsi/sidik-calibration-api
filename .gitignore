# Ditulis `/.vscode/*`, bukan `/.vscode` — git nggak bisa nge-include balik
# file yang FOLDER induknya diabaikan. Dengan pola ini, isinya tetap diabaikan
# semua kecuali yang dikecualikan di bawah.
/.vscode/*
# Setelan lint project ikut di-commit biar semua yang buka repo ini dapat
# editor yang sama bersihnya (at-rule Tailwind v4 nggak dikenali VS Code).
# Setelan pribadi lain di /.vscode tetap diabaikan.
!/.vscode/settings.json
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
_ide_helper_models.php
Homestead.json
Homestead.yaml
Thumbs.db
worklog.csv

# Artefak Python dari skrip di docs/skrip/. Bukan bagian dari aplikasi Laravel,
# tapi begitu skripnya pernah dijalanin/dicompile, __pycache__ kebentuk sendiri
# dan gampang keikut `git add`.
__pycache__/
*.pyc

# Master data mentah turbidimeter (CSV ekspor Excel lab) — sumber acuan hitungan,
# tapi isinya sertifikat asli + nama pelanggan. Angkanya udah masuk kode lewat
# TurbidimeterCapabilitySeeder/TurbidimeterSeeder, jadi CSV mentahnya nggak perlu
# ikut ke repo.
Project-PT-Sidik/Master Data TurbidiMeter_CSV/
# Idem buat chlorine meter — isinya sertifikat 0189-CAL-624 + nama & alamat
# pelanggan asli. Angkanya udah masuk ChlorineCapabilitySeeder/ChlorineSeeder.
Project-PT-Sidik/Chlorine_Meter_CSV/
# Idem buat spectrophotometer — CSV + .xlsm + lembar kerja asli SIDIK-FM-CAL-0511.
# Angkanya udah masuk SpectrophotometerCapabilitySeeder/SpectrophotometerSeeder.
Project-PT-Sidik/Master_Olah_Data_Spectrofotometer_CSV/
# Idem buat pH, conductivity, dan refractometer — CSV + .xlsm + ringkasan _RAPI
# semuanya nyebut nama & alamat pelanggan asli (mis. sertifikat 012-CAL-524).
# Angkanya udah masuk PhMeterSeeder/ThermohygroSeeder lewat database/data/*.json
# dan ke profil kalibrasi masing-masing alat.
Project-PT-Sidik/Master Olah Data_pH for trial.xlsm
Project-PT-Sidik/Master Olah Data_pH for trial_CSV/
Project-PT-Sidik/Master Olah Data_pH for trial_RAPI/
Project-PT-Sidik/Master Data Conductivity/
Project-PT-Sidik/Refractometer_CSV/
# Idem buat viscometer — CSV ekspor workbook + lembar kerja asli
# SIDIK-FM-CAL-0524_Rev.3. Isinya serial sertifikat larutan standar Paragon
# dan seluruh riwayat revisi master. Angkanya udah masuk
# ViscometerCapabilitySeeder/ViscometerSeeder dan ViscometerProfile.
Project-PT-Sidik/Master_Olah_Data_Viscometer_CSV/

# CATATAN/ isinya berkas mentah dari lab: sertifikat terbit (CAL-2026-07-0017),
# kop surat, dan ekspor CSV workbook pH yang bawa nama & alamat pelanggan.
# Satu-satunya yang DIKECUALIKAN: DATABASE.csv — itu master internal lab
# (nomor IK, standar, penandatangan, CMC), nol data pelanggan, DAN dibaca
# saat runtime oleh MetodeKalibrasiSeeder lewat `base_path()`. Kalau ikut
# diabaikan, hasil clone bersih nggak dapet satu pun metode kalibrasi.
CATATAN/*
!CATATAN/ini-yang-dari-karywan-manual/
CATATAN/ini-yang-dari-karywan-manual/*
!CATATAN/ini-yang-dari-karywan-manual/DATABASE.csv
