<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Sejumlah test nyetak sertifikat PDF beneran lewat dompdf, dan dompdf
            rakus memori (font, canvas, gambar QR) sekali jalan. Batas bawaan CLI
            (128 MB) kehabisan di tengah suite begitu jumlah test-nya nambah.
            Dinaikin di sini, bukan di php.ini, biar semua orang & CI jalan
            dengan batas yang sama.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!--
          Penyedia AI dipatok di sini, BUKAN diwarisin dari `.env`.

          Test WorksheetExtraction nge-fake HTTP-nya Anthropic. Waktu `.env`
          dev dipindah ke Gemini, delapan test itu langsung pecah — bukan
          karena kodenya salah, tapi karena mereka jadi nembak host yang
          nggak difake. Test nggak boleh ikut berubah tiap ada yang ganti
          setelan lokal.
        -->
        <env name="VISION_DRIVER" value="anthropic"/>
        <!--
          Alamat penyedianya dipatok di `Tests\TestCase::setUp()`, BUKAN di
          sini. `<env>` nggak bisa dipakai buat itu: PHPUnit cuma nyetel
          variabel yang belum ada, dan yang bikin masalah justru variabel shell
          yang udah nangkring duluan (`ANTHROPIC_BASE_URL` ke proxy lokal).
        -->

        <!--
            Zona waktu HARUS sama kayak produksi (Asia/Jakarta). Kalau test jalan
            di UTC sementara server jalan di Jakarta, seluruh bug tanggal jadi
            nggak kelihatan: kolom bertipe `date` yang di-serialize sebagai ISO
            nulis `2024-05-25T17:00:00Z` buat tanggal `2024-05-26`, dan nggak ada
            satu pun test yang bisa nangkep itu. Udah pernah kejadian di laporan.
        -->
        <env name="APP_TIMEZONE" value="Asia/Jakarta"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
